---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-inner">
      <p>&copy; {currentYear} <span>数字花园</span> &middot; 用 ❤️ 和 Astro 构建 &middot; 托管于 GitHub Pages</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-soft);
    padding: 2rem 0;
    margin-top: 4rem;
    position: relative;
    z-index: 1;
  }

  .footer-inner {
    text-align: center;
  }

  .footer p {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .footer p span {
    transition: color 0.2s;
    cursor: default;
  }

  .footer p span:hover {
    color: var(--accent);
  }
</style>
