---
export interface Props {
  repo?: string;
  repoId?: string;
  category?: string;
  categoryId?: string;
  mapping?: string;
  strict?: string;
  reactionsEnabled?: string;
  emitMetadata?: string;
  inputPosition?: string;
  theme?: string;
  lang?: string;
  loading?: string;
}

const {
  repo = "shucheng/mywebsite",
  repoId = "",
  category = "Announcements",
  categoryId = "",
  mapping = "pathname",
  strict = "0",
  reactionsEnabled = "1",
  emitMetadata = "0",
  inputPosition = "bottom",
  theme = "dark",
  lang = "zh-CN",
  loading = "lazy",
} = Astro.props;
---

<section class="giscus-wrapper">
  <div id="giscus-comments"></div>

  <script
    src="https://giscus.app/client.js"
    data-repo={repo}
    data-repo-id={repoId}
    data-category={category}
    data-category-id={categoryId}
    data-mapping={mapping}
    data-strict={strict}
    data-reactions-enabled={reactionsEnabled}
    data-emit-metadata={emitMetadata}
    data-input-position={inputPosition}
    data-theme={theme}
    data-lang={lang}
    data-loading={loading}
    async
  >
  </script>

  <noscript>
    <p class="noscript">需要启用 JavaScript 才能查看评论。</p>
  </noscript>
</section>

<style>
  .giscus-wrapper {
    margin-top: 2rem;
  }

  .noscript {
    text-align: center;
    padding: 2rem;
    color: var(--text-tertiary);
    border: 1px dashed var(--border-primary);
    border-radius: 8px;
  }
</style>
