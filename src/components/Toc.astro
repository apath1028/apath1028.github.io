---
// TOC (Table of Contents) — client-side generated from article headings
// Builds a sticky outline with progress bar, smooth scroll spy, and click lock
---

<aside class="toc-sidebar" id="tocSidebar">
  <nav class="toc-card">
    <div class="toc-title">📑 文章目录</div>
    <!-- Reading progress bar -->
    <div class="toc-progress-track">
      <div class="toc-progress-fill" id="tocProgressFill"></div>
    </div>
    <ul class="toc-list" id="tocList">
      <!-- populated by JS -->
    </ul>
  </nav>
</aside>

<style>
  .toc-sidebar {
    position: sticky;
    top: 2rem;
    align-self: start;
  }

  .toc-card {
    background: var(--bg-glass);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    padding: 1.2rem 1.1rem 0.9rem;
    transition: border-color 0.35s var(--ease-out);
    overflow: hidden;
  }

  .toc-card:hover {
    border-color: rgba(167, 139, 250, 0.15);
  }

  .toc-title {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
    font-weight: 600;
  }

  /* ===== Progress bar ===== */
  .toc-progress-track {
    height: 3px;
    background: var(--border);
    border-radius: 2px;
    margin-bottom: 0.8rem;
    overflow: hidden;
  }

  .toc-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--accent), var(--teal));
    border-radius: 2px;
    transition: width 0.15s linear;
    will-change: width;
  }

  /* ===== TOC list ===== */
  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .toc-item {
    display: block;
    padding: 0.38rem 0.6rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    border-left: 2px solid transparent;
    transition: all 0.3s var(--ease-out);
    cursor: pointer;
    text-decoration: none;
    position: relative;
  }

  .toc-item:hover {
    color: var(--text-secondary);
    background: var(--accent-soft);
    border-left-color: rgba(167, 139, 250, 0.3);
    text-decoration: none;
    padding-left: 0.85rem;
  }

  .toc-item.active {
    color: var(--text-primary);
    border-left-color: var(--accent);
    background: linear-gradient(90deg, var(--accent-soft), transparent 60%);
    font-weight: 500;
    padding-left: 0.85rem;
  }

  /* h1 items — slightly bolder */
  .toc-item.toc-h1 {
    font-weight: 500;
    font-size: 0.85rem;
  }

  /* h3 items — indented */
  .toc-item.toc-h3 {
    padding-left: 1.5rem;
    font-size: 0.78rem;
  }

  .toc-item.toc-h3:hover,
  .toc-item.toc-h3.active {
    padding-left: 1.65rem;
  }

  /* hide on narrow screens */
  @media (max-width: 1100px) {
    .toc-sidebar {
      display: none;
    }
  }
</style>

<script>
  function buildToc() {
    const tocList = document.getElementById("tocList");
    if (!tocList) return;

    const article = document.querySelector(".prose");
    if (!article) return;

    const headings = article.querySelectorAll("h1, h2, h3");
    if (headings.length === 0) {
      const sidebar = document.getElementById("tocSidebar");
      if (sidebar) sidebar.style.display = "none";
      return;
    }

    const seen = new Map<string, number>();
    const headingEls: HTMLElement[] = [];

    headings.forEach((heading, index) => {
      const el = heading as HTMLElement;
      const level = el.tagName.toLowerCase();
      let id = el.textContent?.trim() || `heading-${index}`;
      // slugify: keep Chinese chars, alphanumeric, hyphens
      id = id
        .replace(/\s+/g, "-")
        .replace(/[^\w一-鿿-]/g, "")
        .substring(0, 50);

      // deduplicate
      if (seen.has(id)) {
        const count = seen.get(id)! + 1;
        seen.set(id, count);
        id = `${id}-${count}`;
      } else {
        seen.set(id, 1);
      }

      el.id = id;
      headingEls.push(el);

      // Build TOC link
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = `#${id}`;
      // Assign class based on heading level
      a.className = level === "h3" ? "toc-item toc-h3"
        : level === "h1" ? "toc-item toc-h1"
        : "toc-item";
      a.textContent = el.textContent?.trim() || "";

      a.addEventListener("click", (e) => {
        e.preventDefault();
        // Lock scroll spy during smooth scroll
        scrollLock = true;
        // Immediately set active
        setActive(id);
        // Scroll with offset for the fixed sidebar
        const top = el.getBoundingClientRect().top + window.scrollY - 100;
        window.scrollTo({ top, behavior: "smooth" });
        // Release lock after animation completes
        clearTimeout(lockTimer);
        lockTimer = window.setTimeout(() => {
          scrollLock = false;
          updateActive();
        }, 900);
      });

      li.appendChild(a);
      tocList.appendChild(li);
    });

    // Start scroll spy
    initScrollSpy(headingEls);
    initProgressBar();
  }

  // ===== Scroll spy =====
  let scrollLock = false;
  let lockTimer = 0;
  let currentActiveId = "";

  function setActive(id: string) {
    if (id === currentActiveId) return;
    currentActiveId = id;
    document.querySelectorAll(".toc-item").forEach((el) => {
      const href = el.getAttribute("href")?.replace("#", "");
      el.classList.toggle("active", href === id);
    });
  }

  function initScrollSpy(headings: HTMLElement[]) {
    const tocLinks = document.querySelectorAll(".toc-item");
    if (tocLinks.length === 0 || headings.length === 0) return;

    // build a map: heading id → heading element
    const headingMap = new Map<string, HTMLElement>();
    headings.forEach((h) => headingMap.set(h.id, h));

    // ordered list of heading IDs (in document order)
    const headingIds = Array.from(headingMap.keys());

    function updateActive() {
      if (scrollLock) return;

      const DETECT_LINE = 120; // px from viewport top
      let activeId: string | null = null;

      for (const id of headingIds) {
        const el = headingMap.get(id);
        if (!el) continue;
        const rect = el.getBoundingClientRect();
        // heading is "active" if its top is above (or at) the detection line
        if (rect.top <= DETECT_LINE) {
          activeId = id;
        } else {
          // remaining headings are further down — stop
          break;
        }
      }

      // If no heading has passed the line yet, default to the first heading
      if (!activeId && headingIds.length > 0) {
        activeId = headingIds[0];
      }

      if (activeId) setActive(activeId);
    }

    // Throttled scroll listener
    let ticking = false;
    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateActive();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    // Initial call
    updateActive();
  }

  // ===== Reading progress bar =====
  function initProgressBar() {
    const fill = document.getElementById("tocProgressFill");
    if (!fill) return;

    let ticking = false;
    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const article = document.querySelector(".prose");
          if (!article) return;

          const rect = article.getBoundingClientRect();
          const articleHeight = rect.height;
          const visibleTop = Math.max(0, -rect.top);
          const viewportH = window.innerHeight;

          // progress = how much of the article has scrolled past the top
          // ranges from 0 (not started) to ~1 (reached end)
          if (articleHeight <= viewportH) {
            fill.style.width = "100%";
          } else {
            const progress = Math.min(
              100,
              Math.max(0, (visibleTop / (articleHeight - viewportH)) * 100)
            );
            fill.style.width = progress + "%";
          }

          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }

  // Run after DOM is ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", buildToc);
  } else {
    buildToc();
  }
</script>
