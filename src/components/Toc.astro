---
// TOC (Table of Contents) — client-side generated from article headings
// Builds a sticky outline with progress bar, smooth scroll spy, and click lock
---

<aside class="toc-sidebar" id="tocSidebar">
  <button
    class="toc-mobile-toggle"
    id="tocMobileToggle"
    type="button"
    aria-controls="tocCard"
    aria-expanded="false"
    title="打开文章目录"
  >
    <span class="toc-toggle-icon" aria-hidden="true">≡</span>
    <span>目录</span>
  </button>
  <nav class="toc-card" id="tocCard" aria-label="文章目录">
    <div class="toc-title">📑 文章目录</div>
    <!-- Reading progress bar -->
    <div class="toc-progress-track">
      <div class="toc-progress-fill" id="tocProgressFill"></div>
    </div>
    <ul class="toc-list" id="tocList">
      <!-- populated by JS -->
    </ul>
  </nav>
</aside>

<style is:global>
  .toc-sidebar {
    position: fixed;
    top: 2rem;
    right: max(2.5rem, calc(50vw - 750px + 2.5rem));
    z-index: 20;
    width: var(--toc-w);
  }

  .toc-mobile-toggle {
    display: none;
  }

  .toc-card {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 4rem);
    min-height: 0;
    background: var(--bg-glass);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    padding: 1.2rem 1.1rem 0.9rem;
    transition: border-color 0.35s var(--ease-out);
    overflow: hidden;
  }

  .toc-card:hover {
    border-color: rgba(167, 139, 250, 0.15);
  }

  .toc-title {
    flex: 0 0 auto;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  /* ===== Progress bar ===== */
  .toc-progress-track {
    flex: 0 0 auto;
    height: 3px;
    background: var(--border);
    border-radius: 2px;
    margin-bottom: 0.8rem;
    overflow: hidden;
  }

  .toc-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--accent), var(--teal));
    border-radius: 2px;
    transition: width 0.15s linear;
    will-change: width;
  }

  /* ===== TOC list ===== */
  .toc-list {
    min-height: 0;
    padding-right: 0.35rem;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
  }

  .toc-list > li {
    min-width: 0;
  }

  .toc-item {
    display: block;
    width: calc(100% - var(--toc-indent, 0rem));
    margin-left: var(--toc-indent, 0rem);
    padding: 0.42rem 0.55rem;
    overflow: hidden;
    font-size: 0.78rem;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    border-left: 2px solid transparent;
    transition: all 0.3s var(--ease-out);
    cursor: pointer;
    text-decoration: none;
    position: relative;
    text-overflow: ellipsis;
    white-space: nowrap;
    letter-spacing: 0;
  }

  .toc-item:hover {
    color: var(--text-secondary);
    background: var(--accent-soft);
    border-left-color: rgba(167, 139, 250, 0.3);
    text-decoration: none;
    padding-left: 0.75rem;
  }

  .toc-item.active {
    color: var(--text-primary);
    border-left-color: var(--accent);
    background: linear-gradient(90deg, var(--accent-soft), transparent 60%);
    font-weight: 500;
    padding-left: 0.75rem;
  }

  .toc-item[data-depth="0"] {
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .toc-item[data-depth="1"] {
    font-size: 0.78rem;
  }

  .toc-item[data-depth="2"],
  .toc-item[data-depth="3"],
  .toc-item[data-depth="4"],
  .toc-item[data-depth="5"] {
    font-size: 0.74rem;
  }

  .toc-list::-webkit-scrollbar {
    width: 5px;
  }

  .toc-list::-webkit-scrollbar-thumb {
    background: var(--text-muted);
    border-radius: 999px;
  }

  @media (max-width: 1100px) {
    .toc-sidebar {
      top: auto;
      right: 1rem;
      bottom: 3.75rem;
      z-index: 70;
      display: flex;
      width: min(22rem, calc(100vw - 2rem));
      flex-direction: column;
      align-items: flex-end;
      gap: 0.6rem;
      pointer-events: none;
    }

    .toc-card {
      order: 1;
      display: none;
      width: 100%;
      height: min(68vh, 32rem);
      padding: 1rem 0.9rem 0.8rem;
      border-color: rgba(167, 139, 250, 0.2);
      box-shadow: 0 18px 48px rgba(0, 0, 0, 0.4);
      pointer-events: auto;
    }

    .toc-sidebar.is-open .toc-card {
      display: flex;
    }

    .toc-mobile-toggle {
      order: 2;
      display: inline-flex;
      min-height: 2.6rem;
      padding: 0.55rem 0.85rem;
      align-items: center;
      gap: 0.4rem;
      border: 1px solid var(--border-soft);
      border-radius: var(--radius);
      background: var(--bg-glass);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.32);
      color: var(--text-primary);
      font: 600 0.82rem/1 var(--font-sans);
      cursor: pointer;
      pointer-events: auto;
    }

    .toc-toggle-icon {
      font-size: 1.15rem;
      line-height: 0.8;
      transform: rotate(90deg);
    }

    .toc-title {
      font-size: 0.92rem;
    }

    .toc-item,
    .toc-item[data-depth="1"] {
      font-size: 0.86rem;
    }

    .toc-item[data-depth="0"] {
      font-size: 0.9rem;
    }

    .toc-item[data-depth="2"],
    .toc-item[data-depth="3"],
    .toc-item[data-depth="4"],
    .toc-item[data-depth="5"] {
      font-size: 0.82rem;
    }
  }

  @media (max-width: 640px) {
    .toc-sidebar {
      right: 0.75rem;
      bottom: 3.5rem;
      width: calc(100vw - 1.5rem);
    }
  }
</style>

<script>
  let cleanupToc: (() => void) | undefined;

  function buildToc() {
    cleanupToc?.();

    const tocList = document.getElementById("tocList");
    if (!tocList) return;

    const sidebar = document.getElementById("tocSidebar");
    const mobileToggle = document.getElementById("tocMobileToggle");
    const progressFill = document.getElementById("tocProgressFill");
    const article = document.querySelector(".prose");
    if (!article || !sidebar || !mobileToggle || !progressFill) return;

    tocList.replaceChildren();
    sidebar.style.removeProperty("display");
    progressFill.style.width = "0%";

    const headings = article.querySelectorAll<HTMLElement>("h1, h2, h3, h4, h5, h6");
    if (headings.length === 0) {
      sidebar.style.display = "none";
      return;
    }

    const controller = new AbortController();
    const { signal } = controller;
    const seen = new Map<string, number>();
    const headingEls: HTMLElement[] = [];
    const headingLevels = Array.from(headings, (heading) =>
      Number.parseInt(heading.tagName.slice(1), 10),
    );
    const baseLevel = Math.min(...headingLevels);
    let scrollLock = false;
    let lockTimer = 0;
    let currentActiveId = "";

    function setMobileOpen(open: boolean) {
      sidebar.classList.toggle("is-open", open);
      mobileToggle.setAttribute("aria-expanded", String(open));
      mobileToggle.setAttribute("title", open ? "关闭文章目录" : "打开文章目录");
    }

    mobileToggle.addEventListener("click", () => {
      setMobileOpen(!sidebar.classList.contains("is-open"));
    }, { signal });

    document.addEventListener("click", (event) => {
      if (
        sidebar.classList.contains("is-open") &&
        event.target instanceof Node &&
        !sidebar.contains(event.target)
      ) {
        setMobileOpen(false);
      }
    }, { signal });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setMobileOpen(false);
    }, { signal });

    function setActive(id: string, centerInList = false) {
      if (id === currentActiveId) return;
      currentActiveId = id;
      tocList.querySelectorAll(".toc-item").forEach((item) => {
        const href = item.getAttribute("href")?.slice(1);
        item.classList.toggle("active", href === id);
      });

      if (centerInList) {
        const activeItem = tocList.querySelector<HTMLElement>(
          `.toc-item[href="#${CSS.escape(id)}"]`,
        );
        if (activeItem) {
          const listRect = tocList.getBoundingClientRect();
          const itemRect = activeItem.getBoundingClientRect();
          const itemTop = itemRect.top - listRect.top + tocList.scrollTop;
          const targetTop = itemTop - (tocList.clientHeight - itemRect.height) / 2;
          const behavior = window.matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "auto"
            : "smooth";
          tocList.scrollTo({ top: targetTop, behavior });
        }
      }
    }

    headings.forEach((heading, index) => {
      const el = heading;
      const level = Number.parseInt(el.tagName.slice(1), 10);
      const depth = Math.max(0, level - baseLevel);
      let id = el.textContent?.trim() || `heading-${index}`;
      // Keep letters and numbers from every language so Chinese headings work.
      id = id
        .replace(/\s+/g, "-")
        .replace(/[^\p{L}\p{N}_-]/gu, "")
        .substring(0, 50);
      if (!id) id = `heading-${index}`;

      // deduplicate
      if (seen.has(id)) {
        const count = seen.get(id)! + 1;
        seen.set(id, count);
        id = `${id}-${count}`;
      } else {
        seen.set(id, 1);
      }

      el.id = id;
      headingEls.push(el);

      // Build TOC link
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = `#${id}`;
      a.className = "toc-item";
      a.dataset.level = String(level);
      a.dataset.depth = String(depth);
      a.style.setProperty("--toc-indent", `${depth * 0.75}rem`);
      a.textContent = el.textContent?.trim() || "";

      a.addEventListener("click", (event) => {
        event.preventDefault();
        setMobileOpen(false);
        scrollLock = true;
        setActive(id);
        const top = el.getBoundingClientRect().top + window.scrollY - 100;
        window.scrollTo({ top, behavior: "smooth" });
        clearTimeout(lockTimer);
        lockTimer = window.setTimeout(() => {
          scrollLock = false;
          updateScrollState();
        }, 900);
      }, { signal });

      li.appendChild(a);
      tocList.appendChild(li);
    });

    let ticking = false;

    function updateScrollState() {
      if (!scrollLock) {
        let activeId = headingEls[0]?.id;
        for (const heading of headingEls) {
          if (heading.getBoundingClientRect().top <= 120) {
            activeId = heading.id;
          } else {
            break;
          }
        }
        if (activeId) setActive(activeId, true);
      }

      const rect = article.getBoundingClientRect();
      if (rect.height <= window.innerHeight) {
        progressFill.style.width = "100%";
      } else {
        const progress = Math.min(
          100,
          Math.max(0, (-rect.top / (rect.height - window.innerHeight)) * 100),
        );
        progressFill.style.width = `${progress}%`;
      }
    }

    function requestUpdate() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateScrollState();
        ticking = false;
      });
    }

    window.addEventListener("scroll", requestUpdate, { passive: true, signal });
    window.addEventListener("resize", requestUpdate, { passive: true, signal });
    updateScrollState();

    cleanupToc = () => {
      clearTimeout(lockTimer);
      setMobileOpen(false);
      controller.abort();
      cleanupToc = undefined;
    };
  }

  document.addEventListener("astro:page-load", buildToc);
  buildToc();
</script>
