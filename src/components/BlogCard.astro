---
import type { CollectionEntry } from "astro:content";
import { getTagClass } from "../lib/tags";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const slug = post.id.replace(/\.mdx?$/, "");
const { title, description, date, category, tags, cover, coverAlt } = post.data;
---

<article class="blog-card reveal reveal-delay-1">
  <a href={`/blog/${slug}`} class="blog-card-link">
    {cover && (
      <div class="blog-card-cover">
        <img src={cover} alt={coverAlt || title} loading="lazy" />
      </div>
    )}
    <div class="blog-card-body">
      <div class="blog-card-meta">
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString("zh-CN", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
        {category && <span class="blog-card-category">{category}</span>}
      </div>
      <h3 class="blog-card-title">{title}</h3>
      {description && <p class="blog-card-desc">{description}</p>}
      {tags && tags.length > 0 && (
        <div class="blog-card-tags">
          {tags.map((tag) => <span class={`tag ${getTagClass(tag)}`}>{tag}</span>)}
        </div>
      )}
    </div>
  </a>
</article>

<style>
  .blog-card {
    display: block;
    background: var(--bg-surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    transition: all 0.35s var(--ease-out);
    position: relative;
    overflow: hidden;
  }

  .blog-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(167, 139, 250, 0.05),
      transparent 50%
    );
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }

  .blog-card::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
    border-radius: 0 2px 2px 0;
    transform: scaleY(0);
    transition: transform 0.35s var(--ease-spring);
  }

  .blog-card:hover {
    transform: translateY(-4px) scale(1.015);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35),
      0 0 60px rgba(167, 139, 250, 0.08);
    border-color: rgba(167, 139, 250, 0.3);
  }

  .blog-card:hover::before {
    opacity: 1;
  }

  .blog-card:hover::after {
    transform: scaleY(1);
  }

  .blog-card:active {
    transform: scale(0.99);
  }

  .blog-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    position: relative;
    z-index: 1;
  }

  .blog-card-cover {
    width: 100%;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    border-bottom: 1px solid var(--border-soft);
    background: var(--bg-elevated);
  }

  .blog-card-cover img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.4s var(--ease-out);
  }

  .blog-card:hover .blog-card-cover img {
    transform: scale(1.03);
  }

  .blog-card-body {
    padding: 1.5rem;
  }

  .blog-card-link:hover {
    text-decoration: none;
  }

  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
    font-variant-numeric: tabular-nums;
  }

  .blog-card-category {
    color: var(--teal);
    font-weight: 600;
  }

  .blog-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    transition: color 0.35s var(--ease-out);
  }

  .blog-card:hover .blog-card-title {
    color: var(--accent);
  }

  .blog-card-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 0.75rem;
  }

  .blog-card-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
</style>
