---
import type { CollectionEntry } from "astro:content";
import { getTagClass } from "../lib/tags";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const slug = post.id.replace(/\.mdx?$/, "");
const { title, description, date, tags } = post.data;
---

<article class="blog-card reveal reveal-delay-1">
  <a href={`/blog/${slug}`} class="blog-card-link">
    <span class="blog-card-date">
      {date.toLocaleDateString("zh-CN", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })}
    </span>
    <h3 class="blog-card-title">{title}</h3>
    {description && <p class="blog-card-desc">{description}</p>}
    {tags && tags.length > 0 && (
      <div class="blog-card-tags">
        {tags.map((tag) => <span class={`tag ${getTagClass(tag)}`}>{tag}</span>)}
      </div>
    )}
  </a>
</article>

<style>
  .blog-card {
    display: block;
    padding: 1.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    transition: all 0.35s var(--ease-out);
    position: relative;
    overflow: hidden;
  }

  .blog-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(167, 139, 250, 0.05),
      transparent 50%
    );
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }

  .blog-card::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
    border-radius: 0 2px 2px 0;
    transform: scaleY(0);
    transition: transform 0.35s var(--ease-spring);
  }

  .blog-card:hover {
    transform: translateY(-4px) scale(1.015);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35),
      0 0 60px rgba(167, 139, 250, 0.08);
    border-color: rgba(167, 139, 250, 0.3);
  }

  .blog-card:hover::before {
    opacity: 1;
  }

  .blog-card:hover::after {
    transform: scaleY(1);
  }

  .blog-card:active {
    transform: scale(0.99);
  }

  .blog-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    position: relative;
    z-index: 1;
  }

  .blog-card-link:hover {
    text-decoration: none;
  }

  .blog-card-date {
    display: block;
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
    font-variant-numeric: tabular-nums;
  }

  .blog-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    transition: color 0.35s var(--ease-out);
  }

  .blog-card:hover .blog-card-title {
    color: var(--accent);
  }

  .blog-card-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 0.75rem;
  }

  .blog-card-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
</style>
