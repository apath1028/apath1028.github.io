---
import type { CollectionEntry } from "astro:content";
import { getTagClass, getTagDotColor } from "../lib/tags";
import { formatPassageDate, passageDateValue } from "../lib/passage-date";

export interface Props {
  posts: CollectionEntry<"passages">[];
}

const { posts } = Astro.props;

const delays = [
  "",
  "reveal-delay-1",
  "reveal-delay-2",
  "reveal-delay-3",
  "reveal-delay-4",
];
---

<div class="bt-timeline">
  {posts.map((post, index) => {
    const slug = post.id.replace(/\.mdx?$/, "");
    const { title, description, date, category, tags } = post.data;
    const firstTag = tags?.[0] || "";
    const dotColor = getTagDotColor(firstTag);
    const delayClass = index < delays.length ? delays[index] : "";

    return (
      <div
        class={`bt-timeline-item reveal ${delayClass}`}
        data-tags={tags?.join(",") || ""}
        data-category={category || ""}
        data-search={[title, description, category, ...(tags || [])]
          .filter(Boolean)
          .join(" ")
          .toLocaleLowerCase("zh-CN")}
      >
        <div class={`bt-timeline-dot ${dotColor}`} />
        <article class="bt-timeline-card">
          <a href={`/passages/${slug}`} class="bt-timeline-link">
            <div class="bt-timeline-meta">
              <time class="bt-timeline-date" datetime={passageDateValue(date)}>
                {formatPassageDate(date)}
              </time>
              {category && <span>{category}</span>}
            </div>
            <h3 class="bt-timeline-title">{title}</h3>
            {description && (
              <p class="bt-timeline-desc">{description}</p>
            )}
          </a>
          {tags && tags.length > 0 && (
            <div class="bt-timeline-tags">
              {tags.map((tag) => (
                <span class={`tag ${getTagClass(tag)}`}>{tag}</span>
              ))}
            </div>
          )}
        </article>
      </div>
    );
  })}
</div>

<style>
  /* ===== Timeline structure ===== */
  .bt-timeline {
    position: relative;
    padding-left: 2.2rem;
  }

  .bt-timeline::before {
    content: "";
    position: absolute;
    left: 0.5rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(
      180deg,
      var(--accent),
      var(--border),
      var(--warm),
      var(--border),
      transparent
    );
  }

  .bt-timeline-item {
    position: relative;
    padding-bottom: 1.5rem;
  }

  /* ===== Dots ===== */
  .bt-timeline-dot {
    position: absolute;
    left: -2.2rem;
    top: 0.65rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--bg-base);
    box-shadow: 0 0 10px var(--accent-glow);
    z-index: 1;
    transition: all 0.35s var(--ease-out);
  }

  .bt-timeline-item:hover .bt-timeline-dot {
    transform: scale(1.6);
    box-shadow: 0 0 20px var(--accent-glow), 0 0 40px var(--accent-glow);
  }

  .bt-timeline-dot.warm {
    background: var(--warm);
    box-shadow: 0 0 10px var(--warm-glow);
  }
  .bt-timeline-item:hover .bt-timeline-dot.warm {
    box-shadow: 0 0 20px var(--warm-glow), 0 0 40px var(--warm-glow);
  }

  .bt-timeline-dot.teal {
    background: var(--teal);
    box-shadow: 0 0 10px var(--teal-glow);
  }
  .bt-timeline-item:hover .bt-timeline-dot.teal {
    box-shadow: 0 0 20px var(--teal-glow), 0 0 40px var(--teal-glow);
  }

  .bt-timeline-dot.sky {
    background: var(--sky);
    box-shadow: 0 0 10px var(--sky-glow);
  }
  .bt-timeline-item:hover .bt-timeline-dot.sky {
    box-shadow: 0 0 20px var(--sky-glow), 0 0 40px var(--sky-glow);
  }

  .bt-timeline-dot.rose {
    background: var(--rose);
    box-shadow: 0 0 10px var(--rose-glow);
  }
  .bt-timeline-item:hover .bt-timeline-dot.rose {
    box-shadow: 0 0 20px var(--rose-glow), 0 0 40px var(--rose-glow);
  }

  /* ===== Card ===== */
  .bt-timeline-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    padding: 1.1rem 1.3rem;
    transition: all 0.35s var(--ease-out);
    position: relative;
  }

  .bt-timeline-card:hover {
    border-color: rgba(167, 139, 250, 0.25);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
    transform: translateX(6px);
  }

  /* ===== Link wrapper ===== */
  .bt-timeline-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .bt-timeline-link:hover {
    text-decoration: none;
  }

  /* ===== Content ===== */
  .bt-timeline-date {
    display: inline;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
    font-variant-numeric: tabular-nums;
  }

  .bt-timeline-meta {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    margin-bottom: 0.25rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .bt-timeline-meta span {
    color: var(--teal);
    font-weight: 600;
  }

  .bt-timeline-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
    transition: color 0.3s var(--ease-out);
  }

  .bt-timeline-card:hover .bt-timeline-title {
    color: var(--accent);
  }

  .bt-timeline-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 0.5rem;
  }

  /* ===== Tags ===== */
  .bt-timeline-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  /* ===== Responsive ===== */
  @media (max-width: 640px) {
    .bt-timeline-card:hover {
      transform: translateX(3px);
    }

    .bt-timeline-title {
      font-size: 1.05rem;
    }
  }
</style>
