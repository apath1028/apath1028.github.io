---
import "../styles/global.css";
import Sidebar from "./Sidebar.astro";
import Footer from "./Footer.astro";
import { ClientRouter } from "astro:transitions";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Show the right TOC sidebar (article pages) */
  toc?: boolean;
  /** Show the blog navigation sidebar */
  sidebar?: boolean;
}

const {
  title = "Apath's Blog",
  description = "个人博客 — 记录知识、思考与日常",
  image,
  toc = false,
  sidebar = true,
} = Astro.props;

const socialImage = image
  ? new URL(image, Astro.site ?? Astro.url).toString()
  : undefined;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1b2e" />

    {sidebar && (
      <>
        <link rel="preconnect" href="https://jsd.liiiu.cn" crossorigin="anonymous" />
        <link
          rel="stylesheet"
          href="https://jsd.liiiu.cn/gh/willow-god/Sharding-fonts/Yozai-Medium/result.min.css"
        />
      </>
    )}
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    
    <!-- KaTeX -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.17.0/dist/katex.min.css"
      integrity="sha384-0Q/+o/T3e0kG0hYxBLKGpNJMGhRsInh4GZc93JT9J+KBw7S+GcrN8oNIv72A+G1"
      crossorigin="anonymous"
    />

    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class:list={[{ "resume-theme": !sidebar }]}>
    <!-- Ambient background orbs -->
    <div class="bg-orbs">
      <div class="bg-orb bg-orb--1" data-parallax="0.03"></div>
      <div class="bg-orb bg-orb--2" data-parallax="0.05"></div>
      <div class="bg-orb bg-orb--3" data-parallax="0.04"></div>
    </div>

    <!-- Cursor glow -->
    <div class="cursor-glow" id="cursorGlow" transition:persist="cursor-glow"></div>

    <!-- Left sidebar (fixed position, outside grid flow) -->
    {sidebar && <Sidebar />}

    <!-- Content area with optional TOC -->
    <div
      class="page-shell"
      class:list={[{ "page-shell--toc": toc, "page-shell--no-sidebar": !sidebar }]}
    >
      <main class="content-area">
        <slot />
        <Footer />
      </main>
      {toc && <slot name="toc" />}
    </div>
    
    {sidebar && (
      <div
        class="site-runtime"
        id="siteRuntime"
        transition:persist="site-runtime"
        data-start="2025-05-21T00:00:00+08:00"
        aria-live="off"
      >
        本站已苟活: 0 天 00 时 00 分 00 秒
      </div>
    )}

    <!-- Ripple animation style -->
    <style is:global>
      .btn-ripple {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.25);
        transform: scale(0);
        animation: btn-ripple-anim 0.6s ease-out;
        pointer-events: none;
      }
      @keyframes btn-ripple-anim {
        to {
          transform: scale(4);
          opacity: 0;
        }
      }

      .site-runtime {
        position: fixed;
        right: 1.25rem;
        bottom: 1rem;
        z-index: 40;
        padding: 0.45rem 0.75rem;
        border: 1px solid var(--border-soft);
        border-radius: var(--radius-sm);
        background: var(--bg-glass);
        backdrop-filter: blur(14px);
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-variant-numeric: tabular-nums;
        line-height: 1;
        pointer-events: none;
      }

      @media (max-width: 640px) {
        .site-runtime {
          right: 0.75rem;
          bottom: 0.75rem;
          font-size: 0.66rem;
        }
      }
    </style>

    <script>
      // ===== Cursor glow =====
      function initCursorGlow() {
        const glow = document.getElementById("cursorGlow");
        if (!glow) return;
        let mouseX = -500, mouseY = -500;
        let glowX = -500, glowY = -500;
        document.addEventListener("mousemove", (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
        });
        function animate() {
          glowX += (mouseX - glowX) * 0.08;
          glowY += (mouseY - glowY) * 0.08;
          glow.style.left = glowX + "px";
          glow.style.top = glowY + "px";
          requestAnimationFrame(animate);
        }
        animate();
      }
      // ===== Parallax background orbs =====
      function initParallaxOrbs() {
        document.addEventListener("mousemove", (e) => {
          const orbs = document.querySelectorAll("[data-parallax]");
          const cx = window.innerWidth / 2;
          const cy = window.innerHeight / 2;
          const dx = (e.clientX - cx) / cx;
          const dy = (e.clientY - cy) / cy;
          orbs.forEach((orb) => {
            const factor = parseFloat(orb.dataset.parallax || "0.03");
            orb.style.transform = `translate(${dx * factor * 60}px, ${dy * factor * 60}px)`;
          });
        });
      }
      // ===== Scroll reveal =====
      function initScrollReveal() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: "0px 0px -50px 0px" }
        );
        document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
      }
      // ===== Button ripple =====
      function initButtonRipple() {
        document.querySelectorAll(".btn").forEach((btn) => {
          btn.addEventListener("click", function (e) {
            const ripple = document.createElement("span");
            ripple.className = "btn-ripple";
            const rect = this.getBoundingClientRect();
            const size = Math.max(rect.width, rect.height);
            ripple.style.width = ripple.style.height = size + "px";
            ripple.style.left = e.clientX - rect.left - size / 2 + "px";
            ripple.style.top = e.clientY - rect.top - size / 2 + "px";
            this.appendChild(ripple);
            ripple.addEventListener("animationend", () => ripple.remove());
          });
        });
      }
      // ===== About avatar spin =====
      function initAboutAvatar() {
        const avatar = document.getElementById("aboutAvatar");
        if (!avatar) return;
        avatar.addEventListener("mouseenter", () => {
          avatar.style.transform = "rotate(360deg) scale(1.1)";
          avatar.style.transition = "transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1)";
        });
        avatar.addEventListener("mouseleave", () => {
          avatar.style.transform = "rotate(0deg) scale(1)";
        });
      }

      let siteRuntimeTimer;

      function initSiteRuntime() {
        if (siteRuntimeTimer) window.clearInterval(siteRuntimeTimer);

        const runtime = document.getElementById("siteRuntime");
        const startValue = runtime?.dataset.start;
        if (!runtime || !startValue) return;

        const startTime = new Date(startValue).getTime();
        if (Number.isNaN(startTime)) return;

        const updateRuntime = () => {
          const elapsedSeconds = Math.max(0, Math.floor((Date.now() - startTime) / 1000));
          const days = Math.floor(elapsedSeconds / 86400);
          const hours = Math.floor((elapsedSeconds % 86400) / 3600);
          const minutes = Math.floor((elapsedSeconds % 3600) / 60);
          const seconds = elapsedSeconds % 60;
          const pad = (value) => String(value).padStart(2, "0");

          runtime.textContent = `本站已苟活: ${days} 天 ${pad(hours)} 时 ${pad(minutes)} 分 ${pad(seconds)} 秒`;
        };

        updateRuntime();
        siteRuntimeTimer = window.setInterval(updateRuntime, 1000);
      }
      // ===== Init all =====
      initCursorGlow();
      initParallaxOrbs();
      initScrollReveal();
      initButtonRipple();
      initAboutAvatar();
      initSiteRuntime();

      // Re-bind interactions after a ClientRouter navigation replaces page content.
      document.addEventListener("astro:page-load", () => {
        initScrollReveal();
        initButtonRipple();
        initAboutAvatar();
        initSiteRuntime();
      });
    </script>
  </body>
</html>
