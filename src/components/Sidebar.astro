---
export interface Props {
  title?: string;
}

const { title = "Apath" } = Astro.props;
const currentPath = Astro.url.pathname;

function isActive(path: string): string {
  if (path === "/") return currentPath === "/" ? "active" : "";
  return currentPath.startsWith(path) ? "active" : "";
}
---

<aside class="sidebar" id="sidebar" transition:persist="sidebar">
  <div class="sidebar-card">
    <a class="resume-return" href="/" title="Return to resume">
      <span aria-hidden="true">←</span> cv
    </a>

    <!-- Replace the placeholder with an <img> when the avatar is ready. -->
    <a class="sidebar-avatar-link" href="/about" aria-label="About">
      <span class="sidebar-avatar">
        <span class="avatar-placeholder" aria-hidden="true">+</span>
        <span class="avatar-badge" aria-hidden="true">🌱</span>
      </span>
    </a>

    <!-- Name -->
    <div class="sidebar-name">{title}</div>

    <!-- Signature -->
    <p class="sidebar-sig">记录知识与日常<br />noting daily life</p>

    <!-- Divider -->
    <div class="sidebar-divider"></div>

    <!-- Vertical Nav -->
    <nav class="sidebar-nav" id="sidebarNav">
      <a href="/blog" class={`sidebar-nav-link ${isActive("/blog")}`}>
        <span class="nav-icon">🏠</span> Blog Home
      </a>
      <a href="/passages" class={`sidebar-nav-link ${isActive("/passages")}`}>
        <span class="nav-icon">📝</span> Passages
      </a>
      <a href="/thoughts" class={`sidebar-nav-link ${isActive("/thoughts")}`}>
        <span class="nav-icon">💭</span> Thoughts
      </a>
      <a href="/about" class={`sidebar-nav-link ${isActive("/about")}`}>
        <span class="nav-icon">🙋</span> About
      </a>
    </nav>
    
    <!-- Bottom status -->
    <div class="sidebar-status">
      <span class="status-dot"></span> 在线 · 持续生长中
    </div>
  </div>
</aside>

<style>
  .sidebar {
    position: fixed;
    top: 2rem;
    left: max(2.5rem, calc((100vw - 1500px) / 2 + 2.5rem));
    width: var(--sidebar-w);
    height: calc(100vh - 4rem);
    display: flex;
    flex-direction: column;
    z-index: 50;
  }

  .sidebar-card {
    background: var(--bg-glass);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-xl);
    padding: 1.8rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
    transition: border-color 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }

  .resume-return {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-bottom: 0.8rem;
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1;
  }

  .resume-return:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .sidebar-card:hover {
    border-color: rgba(167, 139, 250, 0.2);
    box-shadow: 0 0 60px rgba(167, 139, 250, 0.06);
  }

  /* Avatar placeholder */
  .sidebar-avatar-link {
    display: block;
    margin-bottom: 1rem;
    border-radius: 50%;
    text-decoration: none;
  }

  .sidebar-avatar-link:focus-visible {
    outline-offset: 4px;
  }

  .sidebar-avatar {
    position: relative;
    display: grid;
    width: 108px;
    height: 108px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #666b88, #3b3d55 68%);
    box-shadow: 0 0 30px var(--accent-glow);
    flex-shrink: 0;
    user-select: none;
    place-items: center;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }

  .sidebar-avatar-link:hover .sidebar-avatar {
    box-shadow: 0 0 45px var(--accent-glow), 0 0 70px rgba(45, 212, 191, 0.16);
    transform: scale(1.05);
  }

  .avatar-placeholder {
    color: rgba(232, 230, 240, 0.62);
    font-size: 2rem;
    font-weight: 300;
    line-height: 1;
  }

  .avatar-badge {
    position: absolute;
    right: -7px;
    bottom: -4px;
    display: grid;
    width: 32px;
    height: 32px;
    border: 3px solid var(--bg-base);
    border-radius: 50%;
    background: #3c3f4b;
    font-size: 1.15rem;
    place-items: center;
    pointer-events: none;
  }

  /* Name */
  .sidebar-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
  }

  /* Signature */
  .sidebar-sig {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 1.5rem;
    font-style: italic;
  }

  /* Divider */
  .sidebar-divider {
    width: 40px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
    margin-bottom: 1.2rem;
    flex-shrink: 0;
  }

  /* Nav */
  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: 100%;
    flex: 1;
  }

  .sidebar-nav-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius);
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.25s var(--ease-out);
    cursor: pointer;
    text-decoration: none;
  }

  .sidebar-nav-link:hover {
    color: var(--text-primary);
    background: var(--accent-soft);
    text-decoration: none;
  }

  .sidebar-nav-link.active {
    color: var(--text-primary);
    background: var(--accent-soft);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .sidebar-nav-link .nav-icon {
    font-size: 1.05rem;
    width: 1.4rem;
    text-align: center;
    flex-shrink: 0;
  }

  /* Status */
  .sidebar-status {
    margin-top: auto;
    padding-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.5);
    animation: sidebar-pulse-dot 2s ease-in-out infinite;
  }

  @keyframes sidebar-pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.6); }
  }

  /* ===== Mobile ===== */
  @media (max-width: 768px) {
    .sidebar {
      position: fixed;
      top: 0;
      right: 0;
      left: 0;
      z-index: 80;
      width: 100%;
      height: auto;
      margin: 0;
    }

    .sidebar-card {
      display: grid;
      grid-template-columns: 46px minmax(0, 1fr);
      grid-template-areas:
        "cv cv"
        "avatar name"
        "nav nav";
      gap: 0.55rem 0.65rem;
      padding: 0.65rem 0.8rem 0.75rem;
      align-items: center;
      border-radius: 0 0 var(--radius-lg) var(--radius-lg);
      background: rgba(26, 27, 46, 0.94);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
      text-align: left;
    }

    .resume-return {
      grid-area: cv;
      width: max-content;
      margin: 0;
      padding: 0.1rem 0;
      justify-self: start;
      font-size: 0.72rem;
    }

    .sidebar-avatar-link {
      grid-area: avatar;
      margin: 0;
    }

    .sidebar-avatar {
      width: 46px;
      height: 46px;
    }

    .avatar-placeholder {
      font-size: 1.1rem;
    }

    .avatar-badge {
      right: -4px;
      bottom: -2px;
      width: 18px;
      height: 18px;
      border-width: 2px;
      font-size: 0.68rem;
    }

    .sidebar-name {
      grid-area: name;
      margin: 0;
      font-size: 0.9rem;
      white-space: nowrap;
    }

    .sidebar-sig,
    .sidebar-divider,
    .sidebar-status {
      display: none;
    }

    .sidebar-nav {
      grid-area: nav;
      display: grid;
      min-width: 0;
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.22rem;
    }

    .sidebar-nav-link {
      min-width: 0;
      padding: 0.38rem 0.3rem;
      justify-content: center;
      gap: 0;
      font-size: 0.76rem;
      line-height: 1.2;
      text-align: center;
      white-space: nowrap;
    }

    .sidebar-nav-link .nav-icon {
      display: none;
    }

    .sidebar-nav-link.active {
      box-shadow: inset 0 -2px 0 0 var(--accent);
    }
  }

  @media (max-width: 380px) {
    .sidebar-card {
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 0.45rem 0.5rem;
      padding-inline: 0.65rem;
    }

    .sidebar-avatar {
      width: 42px;
      height: 42px;
    }

    .sidebar-name {
      font-size: 0.82rem;
    }

    .sidebar-nav-link {
      font-size: 0.7rem;
    }
  }
</style>

<script>
  function updateSidebarActive() {
    const currentPath = window.location.pathname;
    document.querySelectorAll(".sidebar-nav-link").forEach((link) => {
      const href = link.getAttribute("href") || "";
      const active = href === "/" ? currentPath === "/" : currentPath.startsWith(href);
      link.classList.toggle("active", active);
    });
  }

  document.addEventListener("astro:page-load", updateSidebarActive);
</script>
