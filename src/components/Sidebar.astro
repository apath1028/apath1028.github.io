---
export interface Props {
  title?: string;
}

const { title = "Shucheng Wei" } = Astro.props;
const currentPath = Astro.url.pathname;

function isActive(path: string): string {
  if (path === "/") return currentPath === "/" ? "active" : "";
  return currentPath.startsWith(path) ? "active" : "";
}
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-card">
    <a class="resume-return" href="/" title="Return to resume">
      <span aria-hidden="true">←</span> cv
    </a>

    <!-- Avatar -->
    <div class="sidebar-avatar" id="sidebarAvatar">🌱</div>

    <!-- Name -->
    <div class="sidebar-name">{title}</div>

    <!-- Signature -->
    <p class="sidebar-sig">记录知识与日常<br />种一片自己的数字花园</p>

    <!-- Divider -->
    <div class="sidebar-divider"></div>

    <!-- Vertical Nav -->
    <nav class="sidebar-nav" id="sidebarNav">
      <a href="/garden" class={`sidebar-nav-link ${isActive("/garden")}`}>
        <span class="nav-icon">🏠</span> Blog Home
      </a>
      <a href="/blog" class={`sidebar-nav-link ${isActive("/blog")}`}>
        <span class="nav-icon">📝</span> Passage
      </a>
      <a href="/thoughts" class={`sidebar-nav-link ${isActive("/thoughts")}`}>
        <span class="nav-icon">💭</span> Thoughts
      </a>
      <a href="/about" class={`sidebar-nav-link ${isActive("/about")}`}>
        <span class="nav-icon">🙋</span> About
      </a>
    </nav>

    <!-- Bottom status -->
    <div class="sidebar-status">
      <span class="status-dot"></span> 在线 · 持续生长中
    </div>
  </div>
</aside>

<style>
  .sidebar {
    position: fixed;
    top: 2rem;
    left: max(2.5rem, calc((100vw - 1500px) / 2 + 2.5rem));
    width: var(--sidebar-w);
    height: calc(100vh - 4rem);
    display: flex;
    flex-direction: column;
    z-index: 50;
  }

  .sidebar-card {
    background: var(--bg-glass);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-xl);
    padding: 1.8rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
    transition: border-color 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }

  .resume-return {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-bottom: 0.8rem;
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1;
  }

  .resume-return:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .sidebar-card:hover {
    border-color: rgba(167, 139, 250, 0.2);
    box-shadow: 0 0 60px rgba(167, 139, 250, 0.06);
  }

  /* Avatar */
  .sidebar-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, #a78bfa, #2dd4bf);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
    margin-bottom: 1rem;
    box-shadow: 0 0 30px var(--accent-glow);
    cursor: pointer;
    transition: all 0.45s var(--ease-spring);
    flex-shrink: 0;
    animation: avatar-float 4s ease-in-out infinite;
    user-select: none;
  }

  @keyframes avatar-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .sidebar-avatar:hover {
    box-shadow: 0 0 50px var(--accent-glow), 0 0 80px rgba(45, 212, 191, 0.2);
    transform: scale(1.08) rotate(5deg);
  }

  /* Name */
  .sidebar-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
  }

  /* Signature */
  .sidebar-sig {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 1.5rem;
    font-style: italic;
  }

  /* Divider */
  .sidebar-divider {
    width: 40px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
    margin-bottom: 1.2rem;
    flex-shrink: 0;
  }

  /* Nav */
  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: 100%;
    flex: 1;
  }

  .sidebar-nav-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius);
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.25s var(--ease-out);
    cursor: pointer;
    text-decoration: none;
  }

  .sidebar-nav-link:hover {
    color: var(--text-primary);
    background: var(--accent-soft);
    text-decoration: none;
  }

  .sidebar-nav-link.active {
    color: var(--text-primary);
    background: var(--accent-soft);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .sidebar-nav-link .nav-icon {
    font-size: 1.05rem;
    width: 1.4rem;
    text-align: center;
    flex-shrink: 0;
  }

  /* Status */
  .sidebar-status {
    margin-top: auto;
    padding-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.5);
    animation: sidebar-pulse-dot 2s ease-in-out infinite;
  }

  @keyframes sidebar-pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.6); }
  }

  /* ===== Mobile ===== */
  @media (max-width: 768px) {
    .sidebar {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      height: auto;
      margin-bottom: 1rem;
    }

    .sidebar-card {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      padding: 1rem;
      border-radius: var(--radius-lg);
    }

    .resume-return {
      width: 100%;
      justify-content: center;
      margin-bottom: 0.25rem;
    }

    .sidebar-avatar {
      width: 40px;
      height: 40px;
      font-size: 1.2rem;
      margin-bottom: 0;
      animation: none;
    }

    .sidebar-name {
      font-size: 0.95rem;
      margin-bottom: 0;
    }

    .sidebar-sig,
    .sidebar-divider,
    .sidebar-status {
      display: none;
    }

    .sidebar-nav {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0;
      width: auto;
    }

    .sidebar-nav-link {
      font-size: 0.8rem;
      padding: 0.35rem 0.6rem;
    }

    .sidebar-nav-link .nav-icon {
      display: none;
    }

    .sidebar-nav-link.active {
      box-shadow: inset 0 -2px 0 0 var(--accent);
    }
  }
</style>

<script>
  // ===== Avatar emoji party =====
  const avatar = document.getElementById("sidebarAvatar");
  if (avatar) {
    const emojis = ["🌱", "🌸", "🌿", "🪴", "🌻", "🌷", "🍀", "🌾", "💐", "🌺"];
    let clickCount = 0;

    avatar.addEventListener("click", function () {
      clickCount++;
      this.textContent = emojis[clickCount % emojis.length];

      const rect = this.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;

      for (let i = 0; i < 8; i++) {
        setTimeout(() => {
          const particle = document.createElement("span");
          particle.textContent =
            emojis[Math.floor(Math.random() * emojis.length)];
          const angle = Math.random() * Math.PI * 2;
          const dist = 20 + Math.random() * 50;
          const tx = Math.cos(angle) * (40 + Math.random() * 60);
          const ty = Math.sin(angle) * (40 + Math.random() * 60) - 40;
          particle.style.cssText = `
            position: fixed; font-size: 1.3rem; pointer-events: none; z-index: 10000;
            left: ${cx + Math.cos(angle) * dist}px;
            top: ${cy + Math.sin(angle) * dist}px;
            animation: particle-pop 0.75s ease-out forwards;
            --tx: ${tx}px;
            --ty: ${ty}px;
          `;
          document.body.appendChild(particle);
          particle.addEventListener("animationend", () => particle.remove());
        }, i * 40);
      }
    });
  }
</script>

<style is:global>
  @keyframes particle-pop {
    0% {
      opacity: 1;
      transform: translate(0, 0) scale(1) rotate(0deg);
    }
    100% {
      opacity: 0;
      transform: translate(var(--tx, 60px), var(--ty, -80px)) scale(0.3)
        rotate(40deg);
    }
  }
</style>
