---
import Layout from "../components/Layout.astro";

const skillRows = [
  [
    ["Python", "fa-python"],
    ["Java", "fa-java"],
    ["JavaScript", "fa-js"],
    ["Node.js", "fa-node-js"],
    ["HTML5", "fa-html5"],
    ["CSS3", "fa-css3-alt"],
    ["PHP", "fa-php"],
    ["Rust", "fa-rust"],
    ["Go", "fa-golang"],
    ["Swift", "fa-swift"],
  ],
  [
    ["React", "fa-react"],
    ["Vue.js", "fa-vuejs"],
    ["Angular", "fa-angular"],
    ["Bootstrap", "fa-bootstrap"],
    ["Sass", "fa-sass"],
    ["Less", "fa-less"],
    ["npm", "fa-npm"],
    ["Yarn", "fa-yarn"],
    ["Laravel", "fa-laravel"],
    ["WordPress", "fa-wordpress"],
  ],
  [
    ["Git", "fa-git-alt"],
    ["GitHub", "fa-github"],
    ["GitLab", "fa-gitlab"],
    ["Docker", "fa-docker"],
    ["Linux", "fa-linux"],
    ["Windows", "fa-windows"],
    ["Apple", "fa-apple"],
    ["Figma", "fa-figma"],
    ["Cloudflare", "fa-cloudflare"],
    ["AWS", "fa-aws"],
  ],
];
---

<Layout title="关于 — Apath's Blog" description="关于我">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  </Fragment>
  <div class="about-page container reveal">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
      <div class="hero-orb hero-orb-two" aria-hidden="true"></div>
      <div class="hero-content">
        <div class="hero-avatar-row">
          <div class="float-cloud float-cloud-left" aria-hidden="true">
            <span class="float-text float-text-1">🐝 勤劳小蜜蜂</span>
            <span class="float-text float-text-2">🧱 踏实实在人</span>
            <span class="float-text float-text-3">🧘 努力小天使</span>
            <span class="float-text float-text-4">🦢 乐观大白鹅</span>
          </div>
          <div class="hero-avatar-placeholder" aria-label="头像占位符">头像</div>
          <div class="float-cloud float-cloud-right" aria-hidden="true">
            <span class="float-text float-text-5">🧑‍🚀 阳光小少年</span>
            <span class="float-text float-text-6">🌞 温暖小太阳</span>
            <span class="float-text float-text-7">🐰 可爱小白兔</span>
            <span class="float-text float-text-8">🐖 懒惰小胖猪</span>
          </div>
        </div>
        <h1 id="about-title" class="hero-title">
          <span class="greeting">Hi! I'm</span>
          <span class="name-glow">Apath</span>
        </h1>
        <p class="hero-motto">记录知识、思考与日常</p>
      </div>
    </section>

    <section class="about-card-grid">
      <section class="about-card about-card-profile">
        <div class="panel-head"><span>Identity</span><h2>基本信息</h2></div>
        <div class="info-list">
          <div class="info-item"><span class="info-label">姓名</span><span class="info-value">Apath</span></div>
          <div class="info-item"><span class="info-label">昵称</span><span class="info-value"></span></div>
          <div class="info-item"><span class="info-label">性别</span><span class="info-value">男</span></div>
          <div class="info-item"><span class="info-label">学校</span><span class="info-value">OUC</span></div>
          <div class="info-item"><span class="info-label">专业</span><span class="info-value">通信工程</span></div>
          <div class="info-item"><span class="info-label">研究方向</span><span class="info-value">CV</span></div>
          <div class="info-item"><span class="info-label">地址</span><span class="info-value">山东青岛</span></div>
          <div class="info-item"><span class="info-label">邮箱</span><a class="info-value" href="mailto:scwei8888@163.com" style="font-size: 0.7rem">scwei8888@163.com</a></div>
          <div class="info-item"><span class="info-label">QQ</span><span class="info-value"></span></div>
        </div>
      </section>

      <section class="about-card about-card-personality">
        <div class="panel-head"><span>Personality</span><h2>性格侧写</h2></div>
        <div class="personality-body">
          <div>
            <p class="personality-type">INFP-T</p>
            <p class="personality-name">调停者</p>
            <p class="personality-summary">温和、敏感而富有想象力，重视内心的价值观，也喜欢把零散的想法整理成有意义的记录。</p>
            <div class="personality-traits"><span>共情</span><span>想象</span><span>探索</span></div>
            <a href="https://www.16personalities.com/infp-personality" target="_blank" rel="noopener">查看详情</a>
          </div>
          <div class="personality-illustration">
            <img src="/images/Blog/About/INFP-T.png" alt="INFP-T 调停者插图" />
          </div>
        </div>
      </section>

      <section class="about-card about-card-skills">
        <div class="panel-head"><span>Capabilities</span><h2>技能与工具</h2></div>
        <div class="skills-viewport">
          <div class="skills-lanes">
            {skillRows.map((row, rowIndex) => (
              <div class:list={["skills-row", rowIndex === 0 && "skills-row-first", rowIndex === 1 && "skills-row-offset", rowIndex === 2 && "skills-row-third"]}>
                {row.map(([label, icon]) => (
                  <span class="skill-chip" role="img" aria-label={label} title={label}>
                    <i class={`fa-brands ${icon}`} aria-hidden="true"></i>
                  </span>
                ))}
              </div>
            ))}
          </div>
        </div>
        <p class="skills-note">正在持续学习中</p>
      </section>

      <section class="about-card about-card-contact">
        <div class="panel-head"><span>Connect</span><h2>联系与兴趣</h2></div>
        <div class="social-grid">
          <a class="social-card" href="https://github.com/apath1028" target="_blank" rel="noopener"><span class="social-icon social-icon-github"><i class="fa-brands fa-github" aria-hidden="true"></i></span><span>GitHub</span></a>
          <a class="social-card" href="#contact-placeholder"><span class="social-icon social-icon-gitee">G</span><span>Gitee</span></a>
          <a class="social-card" href="#QQ"><span class="social-icon social-icon-csdn">csdn</span><span>QQ</span></a>
        </div>
        <div class="hobby-list"><span>阅读</span><span>写作</span><span>编程</span><span>摄影</span></div>
      </section>

      <section class="about-card about-card-projects">
        <div class="panel-head"><span>Projects</span><h2>在做的事</h2></div>
        <div class="project-list">
          <a class="project-item" href="#project-placeholder"><span class="project-kicker">Project</span><strong>[name]</strong><p>[introduction, responsibilities, links]</p></a>
          <a class="project-item" href="#project-placeholder"><span class="project-kicker">Research</span><strong>[directions]</strong><p>[content, progress, achievements]</p></a>
        </div>
        <div class="project-focus"><span>近期节奏</span><div class="project-focus-grid"><div class="project-focus-item"><strong>专业学习</strong><p>通信工程课程</p></div><div class="project-focus-item"><strong>研究探索</strong><p>计算机视觉和图像检索</p></div><div class="project-focus-item"><strong>网站维护</strong><p>持续整理文章</p></div></div></div>
      </section>

      <section class="about-card about-card-evaluation" id="personality-placeholder">
        <div class="panel-head"><span>Snapshot</span><h2>自我评价</h2></div>
        <div class="evaluation-list">
          <div><span>思想</span><p>[^]</p></div>
          <div><span>工作</span><p>[^]</p></div>
          <div><span>总结</span><p>[^]</p></div>
        </div>
      </section>
    </section>
  </div>
</Layout>

<style>
  .about-page { display: flex; width: 100%; max-width: 1180px; flex-direction: column; gap: 1.35rem; }
  .about-hero { position: relative; container-type: inline-size; overflow: hidden; padding: 3rem 2rem; border: 1px solid rgba(167, 139, 250, .16); border-radius: 1.5rem; background: rgba(255,255,255,.03); box-shadow: 0 2px 20px -6px var(--accent-glow); }
  .hero-orb { position: absolute; width: 260px; height: 260px; border-radius: 50%; filter: blur(65px); opacity: .34; pointer-events: none; }
  .hero-orb-one { top: -45%; left: -12%; background: var(--accent-glow); }
  .hero-orb-two { right: -8%; bottom: -45%; background: var(--teal-glow); }
  .hero-content { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; }
  .hero-avatar-row { display: flex; justify-content: center; align-items: center; gap: clamp(.85rem, 3vw, 1.45rem); width: 100%; }
  .hero-avatar-placeholder { display: grid; width: 112px; height: 112px; aspect-ratio: 1; flex: 0 0 112px; place-items: center; border: 4px solid rgba(167,139,250,.28); border-radius: 50%; background: radial-gradient(circle at 35% 25%, #676c89, #36394f 70%); color: rgba(232,230,240,.75); font-size: 1.1rem; font-weight: 700; box-shadow: 0 0 35px var(--accent-glow); }
  .float-cloud { display: flex !important; min-width: 0; flex: none; flex-direction: column !important; gap: .62rem; font-size: .82rem; font-weight: 800; }
  .float-cloud-left { align-items: flex-end; }
  .float-cloud-right { align-items: flex-start; }
  .float-text { display: inline-flex; align-items: center; width: fit-content; max-width: 100%; min-height: 1.75rem; padding: .08rem 1.05rem; border: 1px solid rgba(167,139,250,.28); border-radius: 999px; background: rgba(255,255,255,.035); color: var(--text-primary); white-space: nowrap; box-shadow: inset 0 1px rgba(255,255,255,.12); animation: float-up-down 4s ease-in-out infinite; will-change: transform; }
  .float-text-2, .float-text-3 { margin-inline-end: 1.25rem; }
  .float-text-6, .float-text-7 { margin-inline-start: 1.25rem; }
  .float-text-1, .float-text-5 { animation-delay: .5s; }
  .float-text-2, .float-text-6 { animation-delay: 1s; }
  .float-text-3, .float-text-7 { animation-delay: 1.5s; }
  .float-text-4, .float-text-8 { animation-delay: 2s; }
  @keyframes float-up-down { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
  .hero-title { display: flex; flex-direction: column; gap: .25rem; margin: 0; }
  .greeting { color: var(--text-primary); opacity: .7; font-size: 1rem; font-weight: 400; }
  .name-glow { color: var(--accent-hover); font-size: clamp(1.4rem, 3vw, 1.8rem); font-weight: 800; filter: drop-shadow(0 0 25px var(--accent-glow)); }
  .hero-motto { margin: -.2rem 0 0; color: var(--text-secondary); font-size: .92rem; font-weight: 600; }
  .about-card-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.15rem; align-items: stretch; }
  .about-card { position: relative; min-height: 0; overflow: hidden; padding: clamp(1.05rem, 2.2vw, 1.45rem); border: 1px solid var(--border-soft); border-radius: 1rem; background: rgba(255,255,255,.035); box-shadow: 0 18px 42px -34px var(--accent-glow), inset 0 1px 0 rgba(255,255,255,.12); }
  .about-card-profile, .about-card-projects { grid-column: span 7; }
  .about-card-personality, .about-card-evaluation { grid-column: span 5; }
  .about-card-skills { grid-column: span 8; }
  .about-card-contact { grid-column: span 4; }
  .panel-head { display: grid; gap: .3rem; margin-bottom: .95rem; }
  .panel-head span, .project-kicker { color: var(--accent); letter-spacing: .08em; text-transform: uppercase; font-size: .76rem; font-weight: 800; }
  .panel-head h2 { margin: 0; color: var(--text-primary); font-size: clamp(1.15rem, 2vw, 1.45rem); font-weight: 800; line-height: 1.2; }
  .info-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .65rem; }
  .info-item, .social-card, .skill-chip, .project-item, .project-focus-item, .evaluation-list > div { border: 1px solid var(--border-soft); border-radius: .85rem; background: rgba(255,255,255,.025); box-shadow: inset 0 1px rgba(255,255,255,.08); }
  .info-item { display: flex; justify-content: space-between; align-items: center; gap: .7rem; min-height: 3.25rem; padding: .65rem .8rem; }
  .info-label { flex: none; color: var(--text-muted); letter-spacing: .04em; font-size: .78rem; font-weight: 800; }
  .info-value { min-width: 0; color: var(--text-primary); text-align: right; overflow-wrap: anywhere; font-size: .88rem; font-weight: 700; text-decoration: none; }
  a.info-value:hover { color: var(--accent); }
  .personality-body { display: grid; grid-template-columns: minmax(0, 1fr) 11rem; align-items: center; gap: 1rem; min-height: 11rem; }
  .personality-type { margin: 0; color: var(--accent); font-size: .95rem; font-weight: 900; }
  .personality-name { margin: .25rem 0 0; color: var(--text-primary); font-size: 1.8rem; font-weight: 900; }
  .personality-summary { margin: .6rem 0 0; color: var(--text-secondary); font-size: .88rem; line-height: 1.7; }
  .personality-traits, .hobby-list { display: flex; flex-wrap: wrap; gap: .42rem; margin: .68rem 0 .78rem; }
  .personality-traits span, .hobby-list span { display: inline-flex; align-items: center; min-height: 1.65rem; padding: .2rem .58rem; border: 1px solid rgba(167,139,250,.18); border-radius: 999px; background: var(--accent-soft); color: var(--text-primary); font-size: .76rem; font-weight: 800; }
  .personality-body a { display: inline-flex; padding: .28rem .72rem; border: 1px solid rgba(167,139,250,.2); border-radius: 999px; color: var(--text-primary); font-size: .82rem; text-decoration: none; }
  .personality-illustration { display: grid; width: 11rem; height: 12rem; place-items: center; overflow: visible; background: transparent; color: var(--accent); font-size: 3rem; transition: transform .28s var(--ease-spring), filter .28s var(--ease-out); }
  .personality-illustration:hover { transform: scale(1.05) rotate(4deg); filter: drop-shadow(0 10px 22px var(--accent-glow)); }
  .personality-illustration img { display: block; width: 100%; max-width: 100%; height: 100%; max-height: 100%; object-fit: contain; object-position: center; }
  .skills-viewport { margin-inline: calc(-1 * clamp(1.05rem, 2.2vw, 1.45rem)); padding-block: .15rem; overflow: hidden; }
  .skills-lanes { display: grid; gap: .68rem; }
  .skills-row { display: flex; width: max-content; gap: .68rem; }
  .skills-row-first { transform: translateX(-2rem); }
  .skills-row-offset { transform: translateX(.35rem); }
  .skills-row-third { transform: translateX(-.85rem); }
  .skill-chip { display: grid; width: 4rem; height: 4rem; flex: 0 0 4rem; place-items: center; padding: .55rem; color: var(--text-secondary); text-align: center; }
  .skill-chip i { color: var(--text-secondary); font-size: 2rem; line-height: 1; transition: color .2s, transform .2s; }
  .skill-chip:hover { border-color: rgba(167,139,250,.36); }
  .skill-chip:hover i { color: var(--accent); transform: translateY(-2px); }
  .skills-note { margin: .9rem 0 0; color: var(--text-muted); font-size: .9rem; }
  .social-grid { display: grid; gap: .65rem; }
  .social-card { display: flex; align-items: center; gap: .7rem; min-height: 3.45rem; padding: .62rem .72rem; color: var(--text-primary); font-size: .85rem; font-weight: 800; text-decoration: none; }
  .social-card:hover, .project-item:hover { border-color: rgba(167,139,250,.36); background: var(--accent-soft); transform: translateY(-2px); }
  .social-icon { display: grid; width: 2.25rem; height: 2.25rem; flex: 0 0 2.25rem; place-items: center; border-radius: .68rem; background: rgba(245,246,248,.92); color: #1d2028; font-size: 1.15rem; font-weight: 900; }
  .social-icon i { font-size: 1.25rem; line-height: 1; }
  .social-icon-gitee { font-family: Arial, sans-serif; font-size: 1.8rem; }
  .social-icon-csdn { font-size: .7rem; letter-spacing: -.04em; }
  .project-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; }
  .project-item { display: grid; min-height: 7.1rem; gap: .35rem; padding: .9rem; color: var(--text-primary); text-decoration: none; }
  .project-item strong { font-size: 1rem; }
  .project-item p { margin: 0; color: var(--text-secondary); font-size: .88rem; line-height: 1.7; }
  .project-focus { display: grid; gap: .65rem; margin-top: .85rem; }
  .project-focus > span { color: var(--accent); font-size: .78rem; font-weight: 900; }
  .project-focus-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6rem; }
  .project-focus-item { padding: .72rem .78rem; }
  .project-focus-item strong { display: block; color: var(--text-primary); font-size: .88rem; }
  .project-focus-item p { margin: .28rem 0 0; color: var(--text-muted); font-size: .8rem; line-height: 1.65; }
  .evaluation-list { display: grid; gap: .65rem; }
  .evaluation-list > div { padding: .78rem .85rem; }
  .evaluation-list span { display: inline-block; margin-bottom: .35rem; color: var(--accent); letter-spacing: .05em; font-size: .78rem; font-weight: 900; }
  .evaluation-list p { margin: 0; color: var(--text-secondary); font-size: .88rem; line-height: 1.65; }
  @container (max-width: 650px) {
    .hero-avatar-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-areas: "avatar avatar" "left right"; gap: 1rem .7rem; }
    .hero-avatar-placeholder { grid-area: avatar; width: 96px; height: 96px; flex-basis: 96px; justify-self: center; font-size: 1rem; }
    .float-cloud { width: 100%; gap: .5rem; }
    .float-cloud-left { grid-area: left; align-items: stretch; }
    .float-cloud-right { grid-area: right; align-items: stretch; }
    .float-text { width: 100%; min-width: 0; min-height: 2rem; justify-content: center; padding: .2rem .45rem; overflow: hidden; font-size: .74rem; text-overflow: ellipsis; }
    .float-text-2, .float-text-3, .float-text-6, .float-text-7 { margin-inline: 0; }
  }
  @media (max-width: 1020px) { .about-card-profile, .about-card-personality, .about-card-skills, .about-card-contact, .about-card-projects, .about-card-evaluation { grid-column: 1 / -1; } .info-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 680px) { .about-page.container { padding-inline: 0; } .about-hero { padding: 1.6rem .75rem 2rem; border-radius: 1.15rem; } .hero-content { gap: .85rem; } .greeting { font-size: .92rem; } .name-glow { font-size: 1.55rem; } .hero-motto { font-size: .86rem; } .about-card-grid { gap: 1rem; } .about-card { padding: 1rem; border-radius: .85rem; } .social-grid, .project-list, .project-focus-grid { grid-template-columns: 1fr; } .info-list { grid-template-columns: 1fr; } .personality-body { grid-template-columns: 1fr; min-height: 0; } .personality-illustration { width: 8rem; height: 9rem; justify-self: center; font-size: 2.2rem; } .skill-chip { width: 3.35rem; height: 3.35rem; flex-basis: 3.35rem; } .skill-chip i { font-size: 1.65rem; } }
  @media (max-width: 390px) { .float-text { font-size: .68rem; } .hero-avatar-row { gap: .85rem .45rem; } }
</style>




