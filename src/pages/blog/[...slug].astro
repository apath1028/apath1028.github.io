---
import Layout from "../../components/Layout.astro";
import Giscus from "../../components/Giscus.astro";
import Toc from "../../components/Toc.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { slug: post.id.replace(/\.mdx?$/, "") },
      props: { id: post.id },
    }));
}

const { id } = Astro.props;
const post = await getEntry("blog", id);
if (!post) throw new Error(`Post not found: ${id}`);
const { Content } = await render(post);
const { title, description, date, updatedDate, category, tags, cover, coverAlt } = post.data;

const publishedPosts = (await getCollection("blog"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const currentIndex = publishedPosts.findIndex((entry) => entry.id === post.id);
const previousPost = currentIndex > 0 ? publishedPosts[currentIndex - 1] : undefined;
const nextPost =
  currentIndex >= 0 && currentIndex < publishedPosts.length - 1
    ? publishedPosts[currentIndex + 1]
    : undefined;
const postHref = (entry: (typeof publishedPosts)[number]) =>
  `/blog/${entry.id.replace(/\.mdx?$/, "")}`;
---

<Layout title={`${title} — Apath's Blog`} description={description} image={cover} toc={true}>
  <article class="article reveal">
    <header class="article-header">
      <a href="/blog" class="article-back">
        <span class="arr">←</span> Return to Article List
      </a>
      <h1 class="article-title">{title}</h1>
      <div class="article-meta">
        <span>
          Published on
          <time datetime={date.toISOString()}>
            {date.toLocaleDateString("zh-CN", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        </span>
        {updatedDate && (
          <span>
            Updated on
            <time datetime={updatedDate.toISOString()}>
              {updatedDate.toLocaleDateString("zh-CN")}
            </time>
          </span>
        )}
        {category && <a class="article-category" href={`/blog?category=${encodeURIComponent(category)}`}>{category}</a>}
        {tags && tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag) => <span class="tag tag-purple">{tag}</span>)}
          </div>
        )}
      </div>
    </header>

    {cover && (
      <figure class="article-cover">
        <img src={cover} alt={coverAlt || title} />
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    {(previousPost || nextPost) && (
      <nav class="article-nav" aria-label="相邻文章">
        {previousPost ? (
          <a class="article-nav-item" href={postHref(previousPost)} rel="prev">
            <span>Previous</span>
            <strong>{previousPost.data.title}</strong>
          </a>
        ) : <span />}
        {nextPost ? (
          <a class="article-nav-item article-nav-item--next" href={postHref(nextPost)} rel="next">
            <span>Next</span>
            <strong>{nextPost.data.title}</strong>
          </a>
        ) : <span />}
      </nav>
    )}

    <footer class="article-footer">
      <Giscus />
    </footer>
  </article>

  <Toc slot="toc" />
</Layout>

<style>
  .article {
    /* grid handles positioning; no max-width needed */
  }

  .article-header {
    margin-bottom: 2rem;
  }

  .article-back {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    transition: all 0.25s var(--ease-out);
  }

  .article-back:hover {
    color: var(--accent);
    gap: 0.6rem;
  }

  .article-back .arr {
    transition: transform 0.25s var(--ease-out);
  }

  .article-back:hover .arr {
    transform: translateX(-4px);
  }

  .article-title {
    font-size: 2.4rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  .article-meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--text-muted);
    align-items: center;
  }

  .article-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .article-category {
    color: var(--teal);
    font-weight: 600;
  }

  .article-cover {
    width: 100%;
    aspect-ratio: 16 / 8;
    margin: 0 0 2.5rem;
    overflow: hidden;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
  }

  .article-cover img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .article-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 3.5rem;
  }

  .article-nav-item {
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    background: var(--bg-surface);
    text-decoration: none;
    transition: all 0.25s var(--ease-out);
  }

  .article-nav-item:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .article-nav-item span {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .article-nav-item strong {
    display: block;
    overflow: hidden;
    color: var(--text-primary);
    font-size: 0.9rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .article-nav-item--next {
    text-align: right;
  }

  .article-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-soft);
  }

  @media (max-width: 640px) {
    .article-title {
      font-size: 1.6rem;
    }

    .article-nav {
      grid-template-columns: 1fr;
    }

    .article-nav > span {
      display: none;
    }
  }
</style>
