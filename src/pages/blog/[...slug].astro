---
import Layout from "../../components/Layout.astro";
import Giscus from "../../components/Giscus.astro";
import Toc from "../../components/Toc.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { slug: post.id.replace(/\.mdx?$/, "") },
      props: { id: post.id },
    }));
}

const { id } = Astro.props;
const post = await getEntry("blog", id);
if (!post) throw new Error(`Post not found: ${id}`);
const { Content } = await render(post);
const { title, description, date, tags } = post.data;
---

<Layout title={`${title} — 数字花园`} description={description} toc={true}>
  <article class="article reveal">
    <header class="article-header">
      <a href="/blog" class="article-back">
        <span class="arr">←</span> 返回文章列表
      </a>
      <h1 class="article-title">{title}</h1>
      <div class="article-meta">
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString("zh-CN", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
        {tags && tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag) => <span class="tag tag-purple">{tag}</span>)}
          </div>
        )}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="article-footer">
      <Giscus />
    </footer>
  </article>

  <Toc slot="toc" />
</Layout>

<style>
  .article {
    /* grid handles positioning; no max-width needed */
  }

  .article-header {
    margin-bottom: 2rem;
  }

  .article-back {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    transition: all 0.25s var(--ease-out);
  }

  .article-back:hover {
    color: var(--accent);
    gap: 0.6rem;
  }

  .article-back .arr {
    transition: transform 0.25s var(--ease-out);
  }

  .article-back:hover .arr {
    transform: translateX(-4px);
  }

  .article-title {
    font-size: 2.4rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  .article-meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--text-muted);
    align-items: center;
  }

  .article-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .article-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-soft);
  }

  @media (max-width: 640px) {
    .article-title {
      font-size: 1.6rem;
    }
  }
</style>
