---
import Layout from "../../components/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const postsByYear = posts.reduce((groups, post) => {
  const year = post.data.date.getFullYear();
  const entries = groups.get(year) || [];
  entries.push(post);
  groups.set(year, entries);
  return groups;
}, new Map<number, typeof posts>());

const years = [...postsByYear.entries()];
---

<Layout title="文章归档 — 数字花园" description={`按年份浏览全部 ${posts.length} 篇文章`}>
  <div class="container archive-page">
    <header class="page-header reveal">
      <a href="/blog" class="back-link">← 返回文章列表</a>
      <h1>文章归档</h1>
      <p>按发布时间浏览全部 {posts.length} 篇文章</p>
    </header>

    {years.length > 0 ? (
      <div class="archive-groups">
        {years.map(([year, yearPosts]) => (
          <section class="archive-group reveal">
            <h2>{year}</h2>
            <ol>
              {yearPosts.map((post) => (
                <li>
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString("zh-CN", {
                      month: "2-digit",
                      day: "2-digit",
                    })}
                  </time>
                  <a href={`/blog/${post.id.replace(/\.mdx?$/, "")}`}>
                    {post.data.title}
                  </a>
                  {post.data.category && <span>{post.data.category}</span>}
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    ) : (
      <div class="empty-state">还没有可归档的文章</div>
    )}
  </div>
</Layout>

<style>
  .archive-page {
    max-width: 760px;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .page-header h1 {
    margin-bottom: 0.35rem;
    font-size: 2rem;
  }

  .page-header p {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .archive-groups {
    display: grid;
    gap: 2.25rem;
  }

  .archive-group {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 1.5rem;
  }

  .archive-group h2 {
    color: var(--accent);
    font-size: 1.5rem;
    font-variant-numeric: tabular-nums;
  }

  .archive-group ol {
    list-style: none;
  }

  .archive-group li {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--border-soft);
  }

  .archive-group time {
    color: var(--text-muted);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }

  .archive-group a {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--text-primary);
    font-weight: 600;
  }

  .archive-group span {
    color: var(--teal);
    font-size: 0.75rem;
  }

  @media (max-width: 640px) {
    .archive-group {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .archive-group li {
      grid-template-columns: 3.25rem minmax(0, 1fr);
    }

    .archive-group span {
      display: none;
    }
  }
</style>
