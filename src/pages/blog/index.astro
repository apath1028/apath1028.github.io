---
import Layout from "../../components/Layout.astro";
import BlogCard from "../../components/BlogCard.astro";
import BlogTimeline from "../../components/BlogTimeline.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const publishedPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Extract unique tags (preserve first-appearance order)
const allTags = publishedPosts.flatMap((p) => p.data.tags ?? []);
const uniqueTags = [...new Set(allTags)];
---

<Layout title="文章 — 数字花园" description="博客文章列表">
  <div class="container">
    <header class="page-header reveal">
      <h1>文章</h1>
      <p class="page-desc">共 {publishedPosts.length} 篇文章</p>
    </header>

    <!-- Toolbar: tag filter + view toggle -->
    {uniqueTags.length > 0 && (
      <div class="blog-toolbar reveal reveal-delay-1">
        <div class="tag-filter" id="tagFilter">
          <button class="tag-chip active" data-tag="全部">全部</button>
          {uniqueTags.map((tag) => (
            <button class={`tag-chip tag-chip--${tag}`} data-tag={tag}>
              {tag}
            </button>
          ))}
        </div>
        <div class="view-toggle" id="viewToggle">
          <button class="view-btn active" data-view="grid" title="网格视图">
            ⊞ 网格
          </button>
          <button class="view-btn" data-view="timeline" title="时间线视图">
            ⊡ 时间线
          </button>
        </div>
      </div>
    )}

    <!-- Grid view (default) -->
    <section id="blog-grid">
      {publishedPosts.length > 0 ? (
        <div class="blog-list">
          {publishedPosts.map((post) => (
            <div
              class="blog-item"
              data-tags={post.data.tags?.join(",") || ""}
            >
              <BlogCard post={post} />
            </div>
          ))}
        </div>
      ) : (
        <div class="empty-state"><p>还没有文章，敬请期待 🌱</p></div>
      )}
    </section>

    <!-- Timeline view (hidden by default) -->
    <section id="blog-timeline" style="display:none">
      {publishedPosts.length > 0 ? (
        <BlogTimeline posts={publishedPosts} />
      ) : null}
    </section>

    <!-- Filter empty state -->
    <div id="blog-empty" class="empty-state" style="display:none">
      <p id="blog-empty-text">没有找到匹配的文章</p>
      <button class="btn btn-ghost" id="blog-reset-filter" style="margin-top:1rem">
        查看全部文章
      </button>
    </div>
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: 1.25rem;
  }

  .page-header h1 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.3rem;
  }

  .page-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .blog-list {
    display: grid;
    gap: 1rem;
  }

  /* ===== Toolbar ===== */
  .blog-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  /* ===== Tag filter chips ===== */
  .tag-filter {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    flex: 1;
    min-width: 0;
  }

  .tag-chip {
    font-size: 0.8rem;
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    border: 1px solid var(--border-soft);
    background: var(--bg-surface);
    color: var(--text-secondary);
    transition: all 0.25s var(--ease-out);
    white-space: nowrap;
  }

  .tag-chip:hover {
    background: var(--bg-elevated);
    color: var(--text-primary);
    border-color: var(--border);
    transform: translateY(-1px);
  }

  .tag-chip.active {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
    box-shadow: 0 2px 12px var(--accent-glow);
  }

  /* ===== View toggle ===== */
  .view-toggle {
    display: flex;
    gap: 0;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .view-btn {
    font-size: 0.82rem;
    padding: 0.4rem 0.85rem;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    border: none;
    background: var(--bg-surface);
    color: var(--text-muted);
    transition: all 0.25s var(--ease-out);
    white-space: nowrap;
  }

  .view-btn:first-child {
    border-right: 1px solid var(--border-soft);
  }

  .view-btn:hover {
    background: var(--bg-elevated);
    color: var(--text-primary);
  }

  .view-btn.active {
    background: var(--accent-soft);
    color: var(--accent);
  }

  /* ===== Responsive ===== */
  @media (max-width: 640px) {
    .blog-toolbar {
      flex-direction: column;
      align-items: stretch;
    }

    .tag-filter {
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 0.25rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .tag-filter::-webkit-scrollbar {
      display: none;
    }

    .view-toggle {
      align-self: flex-end;
    }
  }
</style>

<script>
  // ===== State =====
  let activeTag = "全部";
  let activeView = "grid";

  // DOM refs
  const tagChips = document.querySelectorAll(".tag-chip");
  const viewBtns = document.querySelectorAll(".view-btn");
  const blogGrid = document.getElementById("blog-grid");
  const blogTimeline = document.getElementById("blog-timeline");
  const blogEmpty = document.getElementById("blog-empty");
  const emptyText = document.getElementById("blog-empty-text");
  const resetBtn = document.getElementById("blog-reset-filter");

  // ===== Tag filtering =====
  function applyFilter(tag: string) {
    activeTag = tag;

    // Filter grid items
    let visibleCount = 0;
    const gridItems = document.querySelectorAll(".blog-item");
    gridItems.forEach((item) => {
      const el = item as HTMLElement;
      const tags = el.dataset.tags || "";
      const tagList = tags.split(",").filter(Boolean);
      const match = tag === "全部" || tagList.includes(tag);
      el.style.display = match ? "" : "none";
      if (match) visibleCount++;
    });

    // Filter timeline items
    const tlItems = document.querySelectorAll(".bt-timeline-item");
    tlItems.forEach((item) => {
      const el = item as HTMLElement;
      const tags = el.dataset.tags || "";
      const tagList = tags.split(",").filter(Boolean);
      const match = tag === "全部" || tagList.includes(tag);
      el.style.display = match ? "" : "none";
    });

    // Toggle empty state
    if (visibleCount === 0) {
      blogGrid!.style.display = "none";
      blogTimeline!.style.display = "none";
      blogEmpty!.style.display = "";
      if (emptyText) emptyText.textContent = `没有找到包含「${tag}」标签的文章`;
    } else {
      blogEmpty!.style.display = "none";
      applyView(activeView); // restore view visibility
    }

    // Update chip active states
    tagChips.forEach((chip) => {
      chip.classList.toggle("active", (chip as HTMLElement).dataset.tag === tag);
    });
  }

  tagChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      applyFilter((chip as HTMLElement).dataset.tag || "全部");
    });
  });

  // ===== View toggle =====
  function applyView(view: string) {
    activeView = view;
    blogGrid!.style.display = view === "grid" ? "" : "none";
    blogTimeline!.style.display = view === "timeline" ? "" : "none";

    // Don't show anything if empty state is active
    if (blogEmpty!.style.display !== "none") {
      blogGrid!.style.display = "none";
      blogTimeline!.style.display = "none";
    }

    viewBtns.forEach((btn) => {
      btn.classList.toggle("active", (btn as HTMLElement).dataset.view === view);
    });
  }

  viewBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      applyView((btn as HTMLElement).dataset.view || "grid");
    });
  });

  // ===== Reset filter =====
  if (resetBtn) {
    resetBtn.addEventListener("click", () => applyFilter("全部"));
  }
</script>
