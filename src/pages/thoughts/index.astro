---
import Layout from "../../components/Layout.astro";
import ThoughtTimeline from "../../components/ThoughtTimeline.astro";
import { fetchMemosV1 } from "../../lib/memos";

const memosHost = import.meta.env.PUBLIC_MEMOS_HOST || "http://localhost:5230";
const memos = await fetchMemosV1(memosHost);
---

<Layout title="动态 — Apath's Blog" description="日常想法与碎碎念">
  <div class="container">
    <header class="page-header reveal">
      <h1>动态</h1>
      <p class="page-desc">日常想法、灵感和碎碎念</p>
    </header>

    <section>
      {memos.length > 0 ? (
        <ThoughtTimeline memos={memos} />
      ) : (
        <div class="empty-state"><p>暂无动态</p></div>
      )}
    </section>
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.3rem;
  }

  .page-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
